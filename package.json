    "agent": "node agent/agent.mjs",
    "docs": "node tools/docs-preview.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "google-auth-library": "^11.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "marked": "^12.0.2"
  },
  "license": "MIT"
}
