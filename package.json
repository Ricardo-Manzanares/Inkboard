{
  "name": "kindle-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard e-ink para Kindle: recibe métricas, las guarda en JSON y las sirve como PNG",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --max-old-space-size=128 server/index.js",
