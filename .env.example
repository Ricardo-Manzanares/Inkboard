# Variables del servidor (en Railway: pestaña Variables del servicio)

# Secretos propios: genera valores largos aleatorios
# INGEST_TOKEN lo usa el agente del PC para enviar datos; DASH_KEY va en la URL del Kindle (/dash.png?key=...)
INGEST_TOKEN=
DASH_KEY=
# Clave de la página web /web (distinta de DASH_KEY). Vacía = web desactivada
WEB_KEY=

# Volumen de Railway montado en /data para que el JSON sobreviva a los despliegues
DATA_DIR=/data
TZ_DISPLAY=Europe/Madrid
KINDLE_REFRESH_MIN=5

# GitHub: token fine-grained de tu usuario, con todos los repositorios y permiso de lectura en Contents.
# La tarjeta muestra tus contribuciones (calendario y commits por mes y repositorio).
GITHUB_TOKEN=

# Search Console: "sc-domain:midominio.com" para propiedades de dominio, o "https://midominio.com/" para prefijo de URL
GSC_SITE_URL=
# JSON de la service account (tal cual o en base64). La usan Search Console y el gasto de Google Cloud.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gasto de Google Cloud: dataset de la exportación de facturación a BigQuery (la tabla se busca sola)
# y los IDs de proyecto a sumar, separados por comas
GCP_BILLING_TABLE=proyecto.billing_export
GCP_BILLING_PROJECT_IDS=
# Opcional: proyecto del que se muestra el uso de Firebase. Vacío = el primero de la lista
GCP_BILLING_FIREBASE_PROJECT=
# Opcional: ubicación del dataset si no es US ni EU (p. ej. europe-southwest1)
GCP_BILLING_LOCATION=

# Railway: token de cuenta o de workspace (railway.com/account/tokens)
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=
# Opcional: IDs de proyecto separados por comas. Vacío = todos los proyectos que ve el token
RAILWAY_PROJECT_IDS=
