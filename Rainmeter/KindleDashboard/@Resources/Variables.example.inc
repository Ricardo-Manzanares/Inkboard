; Copia este archivo como Variables.inc (o usa Rainmeter\install.ps1, que lo crea solo).
[Variables]
; Servidor y clave del Kindle. Variables.inc no se sube a git.
ServerUrl=CAMBIA_ESTO
Key=CAMBIA_ESTO
; Ancho en pixeles; el alto sigue la proporcion del Kindle (1072x1448). 700 de ancho = 945 de alto.
Width=700
; Tema: dark (tarjetas oscuras, texto claro) o light (tarjetas blancas, texto negro, como el Kindle).
Theme=dark
; Monitor de Rainmeter (1 = el primero), lado (1 = derecha, 0 = izquierda) y separacion del borde.
Monitor=1
Align=1
Margin=24
; Cada cuantas actualizaciones (1 s) se descarga la imagen: 300 = 5 min.
UpdateRate=300
