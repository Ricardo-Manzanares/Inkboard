// Copia este archivo como devices.json (no se sube a git). Inventario de la red local. Admite comentarios con // o /* */.
//
// mac     obligatorio, con ":" o "-" (sale en la lista de detalle del dashboard)
// name    nombre que se muestra
// type    icono y tipo:
//           router     router / puerta de enlace
//           ap         punto de acceso, repetidor o nodo mesh
//           switch     switch
//           powerline  adaptador PLC
//           tv         televisor
//           streamer   reproductor (Fire TV, Chromecast, Android TV box, Apple TV)
//           pc         ordenador de sobremesa
//           laptop     portátil
//           tablet     tablet
//           phone      móvil
//           ereader    lector de libros (Kindle, Kobo)
//           console    videoconsola
//           printer    impresora
//           speaker    altavoz o barra de sonido
//           camera     cámara o videoportero
//           nas        NAS
//           server     servidor, Raspberry Pi, Home Assistant
//           iot        domótica en general (caldera, termostato, sensores)
//           light      luz o bombilla
//           plug       enchufe inteligente
//           watch      reloj
// link    conexión:
//           wifi       por Wi-Fi
//           ethernet   por cable
//           (sin link) va al grupo "Red local, conexión sin indicar"
// parent  opcional: MAC del repetidor, switch o PLC del que cuelga, o "router".
//         Sin parent, el equipo va al grupo Wi-Fi o Ethernet según su link.
// sleeps  opcional: true si se apaga o duerme a menudo; desconectado no cuenta como aviso.
{
  "devices": [
    { "mac": "aa:bb:cc:00:00:01", "name": "Repetidor planta alta", "type": "ap", "link": "ethernet", "parent": "router" },
    { "mac": "aa:bb:cc:00:00:02", "name": "Switch salón", "type": "switch", "link": "ethernet", "parent": "router" },
    { "mac": "aa:bb:cc:00:00:10", "name": "Tele salón", "type": "tv", "link": "ethernet", "parent": "aa:bb:cc:00:00:02" },
    { "mac": "aa:bb:cc:00:00:11", "name": "Portátil", "type": "laptop", "link": "wifi", "parent": "aa:bb:cc:00:00:01" },
    { "mac": "aa:bb:cc:00:00:12", "name": "Móvil", "type": "phone", "link": "wifi" },
    { "mac": "aa:bb:cc:00:00:13", "name": "Kindle", "type": "ereader", "link": "wifi", "sleeps": true }
  ]
}
