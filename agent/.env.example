# Copia a agent/.env
SERVER_URL=https://TU-APP.up.railway.app
INGEST_TOKEN=el-mismo-que-en-railway
IMMICH_URL=http://localhost:2283
# Immich > Ajustes de cuenta > Claves API. Permisos: server.statistics, asset.statistics y queue.read (o job.read); con "all" basta.
IMMICH_API_KEY=
# Dispositivos de la red local (sondeo ARP + mDNS/NetBIOS/SSDP, sin credenciales del router). 0 = desactivado
NET_SCAN=1
# Días que se siguen mostrando los equipos sin identificar que ya no aparecen
NET_FORGET_DAYS=7
